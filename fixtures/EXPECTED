# The verdict each pair must receive. Checked by tools/fixtures.sh, which is run
# in CI. Format: <expected verdict> <fixture name>.
#
# The three NOT-VERIFIED entries are the ones that matter. A checker that
# accepts everything passes the six positives and fails here.

VERIFIED        tiny_unsat
VERIFIED        empty_clause_in_cnf
VERIFIED        deletes_originals
VERIFIED        real_rat_proof
VERIFIED        rat_pigeonhole
VERIFIED        vdw_a217058_n21

NOT-VERIFIED    d08_satisfiable_formula
NOT-VERIFIED    d09_trail_leak_between_candidates
NOT-VERIFIED    d10_duplicate_clause_deleted_once

# The last entry has no files on disk, deliberately. The harness hands the
# checker two paths that do not exist, and the run must come back ERROR(2):
# "I could not read the input" is a third answer, not a verdict about a proof.
# Without this row an unreadable file exits 1 through the Lean runtime and is
# recorded as NOT-VERIFIED -- the checker saying a proof is bad when what it
# means is that it never saw one. Creating a pair under this name breaks the
# test, which is the point.

ERROR(2)        unreadable_input_has_no_verdict
